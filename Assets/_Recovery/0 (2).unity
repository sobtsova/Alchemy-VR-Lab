      m_Calls: []
  m_text: "\u0406\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438:\n1. \u0424\u0456\u043E\u043B\u0435\u0442\u043E\u0432\u0430 \u043F\u043B\u044F\u0448\u043A\u0430 (\u043A\u0430\u0442\u0430\u043B\u0456\u0437\u0430\u0442\u043E\u0440)\n2. \u0420\u0435\u0430\u0433\u0435\u043D\u0442 acid (\u0441\u0442\u0430\u0431\u0456\u043B\u0456\u0437\u0430\u0442\u043E\u0440)\n3. \u041F\u043E\u0434\u0432\u0456\u0439\u043D\u0430 \u043F\u043E\u0440\u0446\u0456\u044F \u0437\u0435\u043B\u0435\u043D\u043E\u0457 \u043F\u043B\u044F\u0448\u043A\u0438\n\n\u041F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u043D\u043D\u044F: \u0417\u043C\u0456\u0448\u0430\u0442\u0438 \u0443 \u0445\u043E\u043B\u043E\u0434\u043D\u0456\u0439 \u0454\u043C\u043D\u043E\u0441\u0442\u0456, \u043F\u043E\u0442\u0456\u043C \u043F\u0456\u0434\u0456\u0433\u0440\u0456\u0442\u0438 \u0441\u0443\u043C\u0456\u0448 \u0440\u0456\u0432\u043D\u043E \u0434\u043E 90\xB0C \u0431\u0435\u0437 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0456\u0457 \u0437\u0430\u0445\u0438\u0441\u043D\u043E\u0433\u043E \u043A\u043E\u043D\u0442\u0443\u0440\u0443.\n\u0415\u0444\u0435\u043A\u0442: \u041F\u043E\u0432\u043D\u0435 \u0440\u043E\u0437\u0447\u0438\u043D\u0435\u043D\u043D\u044F \u043E\u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u0435\u043D\u0438\u0445 \u0437\u0430\u043B\u0438\u0448\u043A\u0456\u0432 \u0442\u0430 \u0456\u0440\u0436\u0456."
