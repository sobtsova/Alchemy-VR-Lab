  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0406\u043D\u0433\u0440\u0435\u0434\u0456\u0454\u043D\u0442\u0438:\n1. \u0417\u0435\u043B\u0435\u043D\u0430 \u043F\u043B\u044F\u0448\u043A\u0430 (\u043E\u0441\u043D\u043E\u0432\u0430)\n2. \u0424\u0456\u043E\u043B\u0435\u0442\u043E\u0432\u0430 \u043F\u043B\u044F\u0448\u043A\u0430 (\u043A\u0430\u0442\u0430\u043B\u0456\u0437\u0430\u0442\u043E\u0440)\n3. \u0420\u0435\u0430\u0433\u0435\u043D\u0442 acid (\u0441\u0442\u0430\u0431\u0456\u043B\u0456\u0437\u0430\u0442\u043E\u0440)\n\n\u041F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u043D\u043D\u044F: \u041D\u0430\u0433\u0440\u0456\u0442\u0438 \u043A\u0430\u0437\u0430\u043D \u0434\u043E 75\xB0C (\u0456\u0437 \u0437\u0430\u0445\u0438\u0441\u043D\u0438\u043C \u043A\u043E\u043D\u0442\u0443\u0440\u043E\u043C), \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u0432\u043E \u0434\u043E\u0434\u0430\u0442\u0438 \u0437\u0435\u043B\u0435\u043D\u0443 \u0442\u0430 \u0444\u0456\u043E\u043B\u0435\u0442\u043E\u0432\u0443 \u0440\u0456\u0434\u0438\u043D\u0438, \u0432\u0432\u0435\u0441\u0442\u0438 \u0440\u0435\u0430\u0433\u0435\u043D\u0442 acid.\n\u0415\u0444\u0435\u043A\u0442: \u0421\u0432\u0456\u0442\u043D\u0435 \u0437\u0456\u043B\u043B\u044F \u043D\u0435\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0457 \u0441\u0438\u043B\u0438."
